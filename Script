	local rightContainer = Instance.new("Frame")
	rightContainer.Size = UDim2.new(0, 80, 0, 18)
	rightContainer.Position = UDim2.new(1, -80, 0.5, -9)
	rightContainer.BackgroundTransparency = 1
	rightContainer.Parent = frame

	local rightLayout = Instance.new("UIListLayout")
	rightLayout.FillDirection = Enum.FillDirection.Horizontal
	rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rightLayout.Padding = UDim.new(0, 3)
	rightLayout.Parent = rightContainer

	local bindBtn = Instance.new("TextButton")
	bindBtn.Size = UDim2.new(0, 36, 0, 18)
	bindBtn.LayoutOrder = 1
	bindBtn.BackgroundColor3 = Color3.fromRGB(14, 10, 20)
	bindBtn.BorderSizePixel = 1
	bindBtn.BorderColor3 = Color3.fromRGB(50, 40, 70)
	bindBtn.Text = defaultKey
	bindBtn.TextColor3 = Color3.fromRGB(170, 150, 200)
	bindBtn.Font = Enum.Font.Code
	bindBtn.TextSize = 8
	bindBtn.Parent = rightContainer

	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0, 38, 0, 18)
	toggleBtn.LayoutOrder = 2
	toggleBtn.BackgroundColor3 = Color3.fromRGB(14, 10, 20)
	toggleBtn.BorderSizePixel = 1
	toggleBtn.BorderColor3 = Color3.fromRGB(50, 40, 70)
	toggleBtn.Text = "OFF"
	toggleBtn.TextColor3 = Color3.fromRGB(140, 40, 40)
	toggleBtn.Font = Enum.Font.Code
	toggleBtn.TextSize = 8
	toggleBtn.Parent = rightContainer

	local state = false
	togglesState[name] = false
	local currentKey = (defaultKey == "M2") and Enum.UserInputType.MouseButton2 or ((defaultKey ~= "---" and Enum.KeyCode[defaultKey]) or nil)

	local function setState(newState)
		state = newState
		if state then
			toggleBtn.Text = "ON"
			toggleBtn.TextColor3 = Color3.fromRGB(160, 80, 255)
			toggleBtn.BorderColor3 = Color3.fromRGB(138, 43, 226)
		else
			toggleBtn.Text = "OFF"
			toggleBtn.TextColor3 = Color3.fromRGB(140, 40, 40)
			toggleBtn.BorderColor3 = Color3.fromRGB(50, 40, 70)
		end
		togglesState[name] = state
		if autoLoadActive then
			local settingsData = {
				Settings = togglesState,
				WindowPos = { X = mainFrame.AbsolutePosition.X, Y = mainFrame.AbsolutePosition.Y },
				AutoLoad = autoLoadActive
			}
			saveToFile("autoload_settings", settingsData)
		end
		if callback then callback(state) end
	end

	toggleBtn.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe or not currentKey then return end
		if input.KeyCode == currentKey or input.UserInputType == currentKey then
			local mode = modeFunc and modeFunc() or "Click"
			if mode == "Hold" then
				setState(true)
			else
				setState(not state)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input, gpe)
		if gpe or not currentKey then return end
		if input.KeyCode == currentKey or input.UserInputType == currentKey then
			local mode = modeFunc and modeFunc() or "Click"
			if mode == "Hold" then
				setState(false)
			end
		end
	end)

	bindBtn.MouseButton1Click:Connect(function()
		bindBtn.Text = "..."
		local connection
		connection = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.MouseButton2 then
				currentKey = (input.UserInputType == Enum.UserInputType.MouseButton2) and Enum.UserInputType.MouseButton2 or input.KeyCode
				bindBtn.Text = (input.UserInputType == Enum.UserInputType.MouseButton2) and "M2" or input.KeyCode.Name
				connection:Disconnect()
			end
		end)
	end)

	table.insert(allElements, { Frame = frame, Name = string.lower(name) })

	local toggleObj = {
		GetState = function() return state end,
		SetState = setState
	}
	registeredToggles[name] = toggleObj
	return toggleObj
end

