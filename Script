local function getAvailableConfigs()
	local list = {}
	if listfiles then
		local success, files = pcall(function() return listfiles(folderName) end)
		if success and files then
			for _, file in ipairs(files) do
				local name = file:match("([^/]+)%.json$")
				if name and name ~= "autoload_settings" then
					list[name] = true
				end
			end
		end
	end
	return list
end

local function refreshConfigList()
	for _, child in pairs(configScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for cfgName, _ in pairs(getAvailableConfigs()) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 20)
		btn.BackgroundTransparency = (selectedConfig == cfgName) and 0 or 1
		btn.BackgroundColor3 = Color3.fromRGB(40, 20, 60)
		btn.Text = "  " .. cfgName
		btn.TextColor3 = Color3.fromRGB(200, 180, 225)
		btn.Font = Enum.Font.Code
		btn.TextSize = 10
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = configScroll

		btn.MouseButton1Click:Connect(function()
			selectedConfig = cfgName
			refreshConfigList()
		end)
	end
end
