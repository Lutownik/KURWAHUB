local folderName = "KurwaConfigs"

local function saveToFile(fileName, data)
	if writefile then
		pcall(function()
			if makefolder then makefolder(folderName) end
		end)
		local success, encoded = pcall(function()
			return HttpService:JSONEncode(data)
		end)
		if success then
			pcall(function()
				writefile(folderName .. "/" .. fileName .. ".json", encoded)
			end)
		end
	end
end

local function loadFromFile(fileName)
	if readfile and isfile then
		local path = folderName .. "/" .. fileName .. ".json"
		local successCheck, exists = pcall(function() return isfile(path) end)
		if successCheck and exists then
			local successRead, content = pcall(function() return readfile(path) end)
			if successRead and content then
				local successDecode, decoded = pcall(function() return HttpService:JSONDecode(content) end)
				if successDecode and decoded then
					return decoded
				end
			end
		end
	end
	return nil
end

