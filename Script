local aimbotGroup = createCategory("AIMBOT")
local aimModeSelector = createSelector(aimbotGroup, "Mode", {"Hold", "Click"}, function(v) end)
local aimbotToggle = createToggleWithBind(aimbotGroup, "Aimbot", "M2", function() return aimModeSelector.GetValue() end, function(v) end)
local targetPartSelector = createSelector(aimbotGroup, "Target Part", {"Head", "Body"}, function(v) end)
createToggleWithBind(aimbotGroup, "FOV Circle", "---", function() return "Click" end, function(v) fovDrawing.Visible = v end)
createSlider(aimbotGroup, "FOV Radius", 30, 300, 80, function(val) fovDrawing.Radius = val end)

RunService.RenderStepped:Connect(function()
	fovDrawing.Position = UserInputService:GetMouseLocation()
	if aimbotToggle.GetState() then
		local targetPartName = (targetPartSelector.GetValue() == "Head") and "Head" or "HumanoidRootPart"
		local closestDist = fovDrawing.Radius
		local targetPos = nil

		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
				local part = p.Character:FindFirstChild(targetPartName) or p.Character:FindFirstChild("HumanoidRootPart")
				if part then
					local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local mousePos = UserInputService:GetMouseLocation()
						local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if dist < closestDist then
							closestDist = dist
							targetPos = part.Position
						end
					end
				end
			end
		end

		if targetPos then
			camera.CFrame = CFrame.new(camera.CFrame.Position, targetPos)
		end
	end
end)

-- 2. WALLHACK
local whGroup = createCategory("WALLHACK")
local espLinesToggle = createToggleWithBind(whGroup, "ESP Lines", "---", function() return "Click" end, function(v) end)
local espHighlightToggle = createToggleWithBind(whGroup, "ESP HighLight", "---", function() return "Click" end, function(v) end)
local espBoxToggle = createToggleWithBind(whGroup, "ESP Box", "---", function() return "Click" end, function(v) end)

local activeTracers = {}
local activeBoxes = {}

RunService.RenderStepped:Connect(function()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local char = p.Character
			if espHighlightToggle.GetState() then
				local hl = char:FindFirstChild("KurwaHighlight")
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "KurwaHighlight"
					hl.FillColor = Color3.fromRGB(138, 43, 226)
					hl.OutlineColor = Color3.fromRGB(200, 180, 225)
					hl.FillTransparency = 0.3
					hl.OutlineTransparency = 0
					hl.Parent = char
				end
				hl.Enabled = true
			else
				local hl = char:FindFirstChild("KurwaHighlight")
				if hl then hl.Enabled = false end
			end
		end
	end

	if espLinesToggle.GetState() then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				if not activeTracers[p] then
					local line = Drawing.new("Line")
					line.Visible = false
					line.Color = Color3.fromRGB(160, 32, 240)
					line.Thickness = 1
					activeTracers[p] = line
				end
				local line = activeTracers[p]
				local hrp = p.Character.HumanoidRootPart
				local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					line.From = Vector2.new(camera.ViewportSize.X / 2, 0)
					line.To = Vector2.new(screenPos.X, screenPos.Y)
					line.Visible = true
				else
					line.Visible = false
				end
			end
		end
	else
		for _, line in pairs(activeTracers) do line.Visible = false line:Remove() end
		activeTracers = {}
	end

	if espBoxToggle.GetState() then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				if not activeBoxes[p] then
					local box = Drawing.new("Square")
					box.Visible = false
					box.Color = Color3.fromRGB(160, 32, 240)
					box.Thickness = 1
					box.Filled = false
					activeBoxes[p] = box
				end
				local box = activeBoxes[p]
				local char = p.Character
				local hrp = char.HumanoidRootPart
				local head = char:FindFirstChild("Head")
				
				if hrp and head then
					local topPos, topOnScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
					local botPos, botOnScreen = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
					
					if topOnScreen and botOnScreen then
						local height = math.abs(topPos.Y - botPos.Y)
						local width = height * 0.6
						box.Size = Vector2.new(width, height)
						box.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
						box.Visible = true
					else
						box.Visible = false
					end
				else
					box.Visible = false
				end
			end
		end
	else
		for _, box in pairs(activeBoxes) do box.Visible = false box:Remove() end
		activeBoxes = {}
	end
end)

